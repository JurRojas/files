---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import WhyWeb from "../components/WhyWeb.astro";
import Metrics from "../components/Metrics.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Value from "../components/Value.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

const title = "REVON - Soluciones Web para tu Negocio";
const description =
  "Páginas web claras, modernas y pensadas para presentar tus servicios, responder dudas y generar confianza las 24 horas.";
---

<BaseLayout title={title} description={description}>
  <Navbar />
  <main>
    <Hero />
    <WhyWeb />
    <Metrics />
    <Services />
    <Process />
    <Value />
    <FAQ />
    <CTA />
  </main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
