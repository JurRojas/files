---
const services = [
  {
    number: "01",
    title: "Landing Pages",
    text: "Páginas enfocadas en presentar un servicio, producto o negocio de forma clara y directa.",
    tag: "Claridad",
  },
  {
    number: "02",
    title: "Sitios Web para Negocios",
    text: "Una presencia digital completa para mostrar quién eres, qué haces y cómo pueden encontrarte.",
    tag: "Presencia digital",
  },
  {
    number: "03",
    title: "Catálogos Digitales",
    text: "Organiza y presenta tus productos o servicios de manera profesional.",
    tag: "Productos y servicios",
  },
  {
    number: "04",
    title: "Presencia Digital",
    text: "Configuración de correo corporativo, Google Maps y herramientas necesarias para fortalecer tu negocio en internet.",
    tag: "Herramientas clave",
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-header">
      <h2>Servicios</h2>
      <p>Soluciones adaptadas a la etapa digital de tu negocio</p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-number">{service.number}</div>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
          <div class="service-tag">{service.tag}</div>
        </article>
      ))}
    </div>
  </div>
</section>
