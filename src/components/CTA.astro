<section class="final-cta" id="contacto">
  <div class="container">
    <div class="cta-content">
      <h2>
        Cuéntame sobre
        <span class="highlight-serif">tu proyecto</span>
      </h2>
      <p>
        Si tienes una idea, un negocio o un servicio que quieres mostrar en internet,
        conversemos. Explícame qué necesitas y encontraremos la mejor forma de construir
        una presencia digital que represente tu trabajo.
      </p>
    </div>

    <form class="contact-form" id="revonWhatsAppForm">
      <div class="form-grid">
        <label class="form-field" for="nombre">
          <span>Nombre</span>
          <input id="nombre" name="nombre" type="text" autocomplete="name" required />
        </label>

        <label class="form-field" for="negocio">
          <span>Nombre del negocio</span>
          <input id="negocio" name="negocio" type="text" autocomplete="organization" required />
        </label>

        <label class="form-field" for="giro">
          <span>Giro del negocio</span>
          <input id="giro" name="giro" type="text" required />
        </label>

        <label class="form-field" for="servicio">
          <span>Servicio de interés</span>
          <select id="servicio" name="servicio" required>
            <option value="">Selecciona una opción</option>
            <option value="Landing Pages">Landing Pages</option>
            <option value="Sitios Web para Negocios">Sitios Web para Negocios</option>
            <option value="Catálogos Digitales">Catálogos Digitales</option>
            <option value="Presencia Digital">Presencia Digital</option>
          </select>
        </label>

        <label class="form-field form-field-full" for="mensaje">
          <span>Mensaje o necesidad principal</span>
          <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
        </label>
      </div>

      <button class="btn btn-primary btn-large" type="submit">Enviar por WhatsApp</button>
    </form>
  </div>
</section>

<script>
  const WHATSAPP_NUMBER = "2721103644";

  const contactForm = document.getElementById("revonWhatsAppForm");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const formData = new FormData(contactForm as HTMLFormElement);
    const nombre = String(formData.get("nombre") ?? "").trim();
    const negocio = String(formData.get("negocio") ?? "").trim();
    const giro = String(formData.get("giro") ?? "").trim();
    const servicio = String(formData.get("servicio") ?? "").trim();
    const mensaje = String(formData.get("mensaje") ?? "").trim();

    const whatsappMessage = `Hola, quiero información sobre una página web para mi negocio.

Nombre: ${nombre}
Negocio: ${negocio}
Giro: ${giro}
Servicio de interés: ${servicio}
Mensaje: ${mensaje}`;

    const encodedMessage = encodeURIComponent(whatsappMessage);
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMessage}`, "_blank", "noopener,noreferrer");
  });
</script>
