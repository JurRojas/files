---
const whatsappNumber = "2721103644";
const whatsappMessage = "Hola, me interesa agendar una cita para un proyecto.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<a
  id="floatingWhatsApp"
  class="floating-whatsapp"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Abrir WhatsApp"
>
  <svg
    class="floating-whatsapp-icon"
    fill="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M12.031 0C5.383 0 0 5.383 0 12.031c0 2.124.553 4.195 1.604 6.012L.116 23.884l6.015-1.576A11.96 11.96 0 0012.031 24c6.648 0 12.031-5.383 12.031-12.031S18.679 0 12.031 0zm0 21.968c-1.802 0-3.568-.485-5.118-1.404l-.367-.217-3.805.997 1.018-3.708-.238-.378A9.92 9.92 0 012.031 12.03c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 9.938-10 9.938zm5.495-7.518c-.301-.151-1.783-.881-2.059-.982-.276-.101-.477-.151-.678.151-.201.302-.779.982-.955 1.183-.176.201-.352.226-.653.075-.301-.151-1.272-.469-2.423-1.498-.895-.799-1.5-1.787-1.676-2.088-.176-.301-.019-.464.132-.614.136-.135.301-.352.452-.528.151-.176.201-.301.301-.502.101-.201.05-.377-.025-.528-.075-.151-.678-1.634-.929-2.237-.245-.589-.495-.509-.678-.518-.176-.009-.377-.009-.578-.009s-.528.075-.804.377c-.276.302-1.055 1.03-1.055 2.513s1.08 2.915 1.231 3.116c.151.201 2.124 3.242 5.143 4.544.718.31 1.278.495 1.716.634.721.229 1.378.197 1.895.119.581-.088 1.783-.729 2.034-1.433.251-.704.251-1.307.176-1.433-.075-.126-.276-.201-.577-.352z"></path>
  </svg>
</a>

<script>
  const FLOATING_WHATSAPP_NUMBER = "2721103644";
  const FLOATING_WHATSAPP_MESSAGE = "Hola, me interesa agendar una cita para un proyecto.";

  const createWhatsAppLink = (mensaje: string) => {
    const infoNegocio = (globalThis as typeof globalThis & { INFO_NEGOCIO?: { whatsapp?: string } }).INFO_NEGOCIO;
    const numero = infoNegocio?.whatsapp ? infoNegocio.whatsapp : FLOATING_WHATSAPP_NUMBER;

    return `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
  };

  document
    .getElementById("floatingWhatsApp")
    ?.setAttribute("href", createWhatsAppLink(FLOATING_WHATSAPP_MESSAGE));
</script>
