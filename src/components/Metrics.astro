---
const metrics = [
  {
    icon: "🤝",
    title: "Genera confianza",
    text: "Una presencia profesional ayuda a que las personas te conozcan mejor antes de contactarte.",
  },
  {
    icon: "💡",
    title: "Responde preguntas frecuentes",
    text: "Horarios, servicios, ubicación, formas de contacto y detalles importantes disponibles en un solo lugar.",
  },
  {
    icon: "🌍",
    title: "Disponible las 24 horas",
    text: "Tu negocio sigue presente aunque estés ocupado atendiendo clientes o realizando otras actividades.",
  },
  {
    icon: "💬",
    title: "Facilita el contacto",
    text: "Menos tiempo explicando lo mismo y más tiempo atendiendo personas realmente interesadas.",
  },
];
---

<section class="metrics" id="beneficios">
  <div class="container">
    <div class="section-header">
      <h2>Lo que una página puede hacer por tu negocio</h2>
      <p>Claridad, confianza y contacto en el momento correcto</p>
    </div>

    <div class="metrics-grid">
      {metrics.map((metric) => (
        <article class="metric-card">
          <div class="metric-icon" aria-hidden="true">{metric.icon}</div>
          <h3>{metric.title}</h3>
          <p>{metric.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
