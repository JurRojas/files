---
const navItems = [
  { label: "Servicios", href: "#servicios" },
  { label: "Proceso", href: "#proceso" },
  { label: "Portafolio", href: "#portafolio" },
  { label: "Contacto", href: "#contacto" },
];
---

<nav class="navbar" aria-label="Navegación principal">
  <div class="navbar-container">
    <a class="navbar-logo" href="/" aria-label="Reon Digital">
      <span class="logo-text">Reon</span>
      <span class="logo-highlight">Digital</span>
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="navLinks"
      aria-expanded="false"
    >
      ☰
    </button>

    <ul class="nav-links" id="navLinks">
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="navbar-actions">
      <div class="lang-selector" aria-label="Selector de idioma">
        <button class="lang-btn active" type="button">ES</button>
        <button class="lang-btn" type="button">EN</button>
      </div>
      <a href="https://wa.me/34666777888" class="btn btn-whatsapp">
        <span aria-hidden="true">💬</span> WhatsApp
      </a>
    </div>
  </div>
</nav>

<script>
  const navToggle = document.getElementById("navToggle");
  const navLinks = document.getElementById("navLinks");

  const closeMenu = () => {
    navLinks?.classList.remove("active");
    navToggle?.setAttribute("aria-expanded", "false");
  };

  navToggle?.addEventListener("click", () => {
    const isOpen = navLinks?.classList.toggle("active") ?? false;
    navToggle.setAttribute("aria-expanded", String(isOpen));
  });

  navLinks?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });
</script>
