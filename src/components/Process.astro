---
const steps = [
  {
    number: "01",
    title: "Conozco tu negocio",
    text: "Primero entiendo qué haces, quiénes son tus clientes y qué objetivos quieres alcanzar.",
    icon: "💬",
  },
  {
    number: "02",
    title: "Organizo la información",
    text: "Definimos qué necesita ver una persona para confiar en tu negocio.",
    icon: "📋",
  },
  {
    number: "03",
    title: "Diseño y desarrollo",
    text: "Construyo una página clara, moderna y enfocada en la experiencia del visitante.",
    icon: "🎨",
  },
  {
    number: "04",
    title: "Publicación",
    text: "Tu sitio queda listo para que cualquier persona pueda conocer tu negocio desde internet.",
    icon: "🚀",
  },
];
---

<section class="process" id="proceso">
  <div class="container">
    <div class="section-header">
      <h2>Cómo trabajo</h2>
      <p>Un proceso claro para convertir tu información en una presencia digital funcional</p>
    </div>

    <div class="process-steps">
      {steps.map((step, index) => (
        <>
          <article class="step">
            <div class="step-number">{step.number}</div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <div class="step-icon" aria-hidden="true">{step.icon}</div>
          </article>
          {index < steps.length - 1 && <div class="step-arrow" aria-hidden="true">→</div>}
        </>
      ))}
    </div>
  </div>
</section>
