---
const floatingElements = [
  { className: "element-1", icon: "📊" },
  { className: "element-2", icon: "🎯" },
  { className: "element-3", icon: "✨" },
];
---

<section class="hero">
  <div class="hero-bg-gradient"></div>
  <div class="container">
    <div class="hero-tag">
      <span class="tag-dot">•</span>
      Soluciones digitales para negocios locales
    </div>

    <h1 class="hero-title">
      Tu negocio digital,
      <span class="highlight-serif">siempre abierto</span>
    </h1>

    <p class="hero-subtitle">
      Dedica tu tiempo a lo importante. Tu página se encarga de presentar tus servicios,
      responder las dudas más comunes y generar confianza en futuros clientes las 24 horas.
    </p>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#contacto">Cuéntame sobre tu negocio</a>
    </div>

    <p class="hero-microcopy">
      Disponible 24 horas · Información clara · Contacto fácil
    </p>

    {floatingElements.map((item) => (
      <div class={`float-element ${item.className}`} aria-hidden="true">
        {item.icon}
      </div>
    ))}
  </div>
</section>
